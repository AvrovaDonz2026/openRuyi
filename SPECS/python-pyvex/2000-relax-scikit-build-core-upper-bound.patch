From 17f053e34e3a796a416f17a1ed8d49744d58417f Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Wed, 28 Oct 2026 21:46:08 +0800
Subject: [PATCH] Relax scikit-build-core upper bound

---
 pyproject.toml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 3e820eb..a2643e4 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["scikit-build-core ~= 1.0.2", "cffi >= 1.0.3;implementation_name == 'cpython'"]
+requires = ["scikit-build-core >= 1.0.2, < 1.2", "cffi >= 1.0.3;implementation_name == 'cpython'"]
 build-backend = "scikit_build_core.build"
 
 [project]
@@ -51,6 +51,7 @@ docs = [
 ]
 
 [tool.scikit-build]
+minimum-version = "build-system.requires"
 build-dir = "scikit_build"
 
 [tool.scikit-build.sdist]
-- 
2.56.0

