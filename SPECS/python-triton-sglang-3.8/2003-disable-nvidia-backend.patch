+            "TRITON_CODEGEN_BACKENDS",
             "TRITON_BUILD_WITH_CCACHE",
             "TRITON_PARALLEL_LINK_JOBS",
             "TRITON_OFFLINE_BUILD",
@@ -380,7 +380,12 @@
         subprocess.check_call(["cmake", "--build", ".", "--target", "mlir-doc"], cwd=cmake_dir)


-backends = [*BackendInstaller.copy(["nvidia", "amd"]), *BackendInstaller.copy_externals()]
+def get_enabled_in_tree_backends():
+    backends = os.getenv("TRITON_CODEGEN_BACKENDS")
+    return ["nvidia", "amd"] if backends is None else [backend for backend in backends.split(";") if backend]
+
+
+backends = [*BackendInstaller.copy(get_enabled_in_tree_backends()), *BackendInstaller.copy_externals()]


 def get_package_dirs():
