Subject: [PATCH] Make Triton plugins and tools selectable
Upstream-Reference: https://github.com/triton-lang/triton/tree/v3.8.0
Upstream-Status: Downstream

Allow the riscv64 package build to omit the CUDA-dependent Python backend
plugin and developer tools while retaining the NVIDIA dialect and lowering
libraries used by common compiler code. Select the packaged in-tree backends
from TRITON_CODEGEN_BACKENDS so the CPU build does not install the NVIDIA
backend package. Other architectures retain the upstream backend defaults.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3f066ea..c29adeb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,0 +24,2 @@ option(TRITON_BUILD_UT "Build C++ Triton Unit Tests" ON)
+option(TRITON_BUILD_EXAMPLES "Build Triton examples and sample plugins" ON)
+option(TRITON_BUILD_TOOLS "Build Triton command-line tools and tests" ON)
@@ -24,0 +27 @@ option(TRITON_BUILD_WITH_CCACHE "Build with ccache (if available)" ON)
+option(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN "Build the NVIDIA Python backend plugin" ON)
@@ -137 +140 @@ include("${TRITON_THIRD_PARTY_CMAKE_VARS_FILE}")
-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
@@ -324,0 +328,4 @@ if(TRITON_BUILD_PYTHON_MODULE)
+  if(NOT "nvidia" IN_LIST TRITON_CODEGEN_BACKENDS)
+    add_subdirectory(third_party/nvidia)
+  endif()
+
@@ -328,2 +335,3 @@ if(TRITON_BUILD_PYTHON_MODULE)
-  # We always build proton dialect
-  list(APPEND TRITON_PLUGIN_NAMES "proton")
+  if(TRITON_BUILD_PROTON)
+    list(APPEND TRITON_PLUGIN_NAMES "proton")
+  endif()
@@ -479 +487 @@ if(TRITON_BUILD_PYTHON_MODULE)
-  if(TRITON_EXT_ENABLED)
+  if(TRITON_EXT_ENABLED AND TRITON_BUILD_EXAMPLES)
@@ -505,11 +513,13 @@ add_subdirectory(third_party/f2reduce)
-add_subdirectory(bin)
-add_subdirectory(test)
-
-if(TRITON_BUILD_UT)
-  add_subdirectory(unittest)
-  # This target runs all the unit tests.
-  add_custom_target(check-triton-unit-tests
-    COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
-    DEPENDS TritonUnitTests
-    USES_TERMINAL
-  )
+if(TRITON_BUILD_TOOLS)
+  add_subdirectory(bin)
+  add_subdirectory(test)
+
+  if(TRITON_BUILD_UT)
+    add_subdirectory(unittest)
+    # This target runs all the unit tests.
+    add_custom_target(check-triton-unit-tests
+      COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
+      DEPENDS TritonUnitTests
+      USES_TERMINAL
+    )
+  endif()
diff --git a/setup.py b/setup.py
index 63c1dcb..1155617 100644
--- a/setup.py
+++ b/setup.py
@@ -343,0 +344,4 @@ class CMakeBuild(build_ext):
+            "TRITON_BUILD_EXAMPLES",
+            "TRITON_BUILD_TOOLS",
+            "TRITON_BUILD_NVIDIA_BACKEND_PLUGIN",
+            "TRITON_CODEGEN_BACKENDS",
@@ -383 +387,6 @@ class CMakeBuild(build_ext):
-backends = [*BackendInstaller.copy(["nvidia", "amd"]), *BackendInstaller.copy_externals()]
+def get_enabled_in_tree_backends():
+    backends = os.getenv("TRITON_CODEGEN_BACKENDS")
+    return ["nvidia", "amd"] if backends is None else [backend for backend in backends.split(";") if backend]
+
+
+backends = [*BackendInstaller.copy(get_enabled_in_tree_backends()), *BackendInstaller.copy_externals()]
diff --git a/third_party/nvidia/CMakeLists.txt b/third_party/nvidia/CMakeLists.txt
index 8486f90..8cb41c9 100644
--- a/third_party/nvidia/CMakeLists.txt
+++ b/third_party/nvidia/CMakeLists.txt
@@ -5 +5 @@ add_subdirectory(lib)
-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
diff --git a/third_party/proton/Dialect/CMakeLists.txt b/third_party/proton/Dialect/CMakeLists.txt
index 9ef6bdc..8c19d82 100644
--- a/third_party/proton/Dialect/CMakeLists.txt
+++ b/third_party/proton/Dialect/CMakeLists.txt
@@ -5 +5 @@ add_subdirectory(lib)
-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_PROTON)
