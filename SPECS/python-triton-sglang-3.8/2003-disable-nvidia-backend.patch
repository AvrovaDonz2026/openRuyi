Subject: [PATCH] Make Triton plugins and tools selectable
Upstream-Reference: https://github.com/triton-lang/triton/tree/v3.8.0
Upstream-Status: Downstream

Allow the riscv64 package build to omit the CUDA-dependent Python backend
plugin and developer tools while retaining the NVIDIA dialect and lowering
libraries used by common compiler code. Select the packaged in-tree backends
from TRITON_CODEGEN_BACKENDS so the CPU build does not install the NVIDIA
backend package. Other architectures retain the upstream backend defaults.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3f066ea..c4ff865 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,7 +21,9 @@ list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 option(TRITON_BUILD_PYTHON_MODULE "Build Python Triton bindings" OFF)
 option(TRITON_BUILD_PROTON "Build the Triton Proton profiler" ON)
 option(TRITON_BUILD_UT "Build C++ Triton Unit Tests" ON)
+option(TRITON_BUILD_TOOLS "Build Triton command-line tools and tests" ON)
 option(TRITON_BUILD_WITH_CCACHE "Build with ccache (if available)" ON)
+option(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN "Build the NVIDIA Python backend plugin" ON)
 option(TRITON_OFFLINE_BUILD "Build without downloading dependencies" OFF)
 option(TRITON_EXT_ENABLED "Build with default visibility for Triton+LLVM symbol exposure to plugin extensions" OFF)
 set(TRITON_CODEGEN_BACKENDS "" CACHE STRING "Enable different codegen backends")
@@ -134,7 +136,7 @@ execute_process(
 )
 include("${TRITON_THIRD_PARTY_CMAKE_VARS_FILE}")

-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
   set_property(
     DIRECTORY
     APPEND
@@ -322,11 +324,16 @@ if(TRITON_BUILD_PYTHON_MODULE)
     add_subdirectory(third_party/${CODEGEN_BACKEND})
   endforeach()

+  if(NOT "nvidia" IN_LIST TRITON_CODEGEN_BACKENDS)
+    add_subdirectory(third_party/nvidia)
+  endif()
+
   if (TRITON_BUILD_PROTON)
     add_subdirectory(third_party/proton)
   endif()
-  # We always build proton dialect
-  list(APPEND TRITON_PLUGIN_NAMES "proton")
+  if(TRITON_BUILD_PROTON)
+    list(APPEND TRITON_PLUGIN_NAMES "proton")
+  endif()
   add_subdirectory(third_party/proton/Dialect)

   if (DEFINED TRITON_PLUGIN_DIRS)
@@ -502,17 +509,19 @@ endif()
 find_package(Threads REQUIRED)

 add_subdirectory(third_party/f2reduce)
-add_subdirectory(bin)
-add_subdirectory(test)
-
-if(TRITON_BUILD_UT)
-  add_subdirectory(unittest)
-  # This target runs all the unit tests.
-  add_custom_target(check-triton-unit-tests
-    COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
-    DEPENDS TritonUnitTests
-    USES_TERMINAL
-  )
+if(TRITON_BUILD_TOOLS)
+  add_subdirectory(bin)
+  add_subdirectory(test)
+
+  if(TRITON_BUILD_UT)
+    add_subdirectory(unittest)
+    # This target runs all the unit tests.
+    add_custom_target(check-triton-unit-tests
+      COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
+      DEPENDS TritonUnitTests
+      USES_TERMINAL
+    )
+  endif()
 endif()

 ################################################################################
