     from sglang.srt.managers.schedule_batch import Req, ScheduleBatch
@@ -685,6 +688,25 @@ def assign_req_to_token_pool(
         load_offset += BLOCK_SIZE


+def _assign_req_to_token_pool_torch(
+    req_pool_indices: torch.Tensor,
+    req_to_token: torch.Tensor,
+    start_offset: torch.Tensor,
+    end_offset: torch.Tensor,
+    out_cache_loc: torch.Tensor,
+) -> None:
+    out_offset = 0
+    for i in range(req_pool_indices.numel()):
+        start = int(start_offset[i])
+        end = int(end_offset[i])
+        req_idx = int(req_pool_indices[i])
+        if end > start:
+            req_to_token[req_idx, start:end] = out_cache_loc[
+                out_offset : out_offset + end - start
+            ]
+        out_offset += end - start
+
+
 def assign_req_to_token_pool_func(
     req_pool_indices: torch.Tensor,
     req_to_token: torch.Tensor,
@@ -694,14 +716,23 @@ def assign_req_to_token_pool_func(
     batch_size: int,
 ):
     if _is_cpu:
-        assign_req_to_token_pool_cpu(
-            req_pool_indices,
-            req_to_token,
-            start_offset,
-            end_offset,
-            out_cache_loc,
-            req_to_token.shape[1],
-        )
+        if assign_req_to_token_pool_cpu is not None:
+            assign_req_to_token_pool_cpu(
+                req_pool_indices,
+                req_to_token,
+                start_offset,
+                end_offset,
+                out_cache_loc,
+                req_to_token.shape[1],
+            )
+        else:
+            _assign_req_to_token_pool_torch(
+                req_pool_indices,
+                req_to_token,
+                start_offset,
+                end_offset,
+                out_cache_loc,
+            )
         return
     assign_req_to_token_pool[(batch_size,)](
         req_pool_indices,
