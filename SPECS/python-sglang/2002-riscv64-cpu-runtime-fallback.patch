From: A. Donz <Avrova@Donz.si>
Subject: [PATCH] sglang: add RISC-V torch-native CPU fallback

Upstream-Status: Downstream (runtime integration prototype)
Upstream-Reference: https://github.com/sgl-project/sglang/issues/18072

The RISC-V CPU path uses PyTorch-native attention and defers optional CPU AOT
operations that are not implemented for this architecture. This patch does not
provide speculative kernels or establish complete RISC-V engine support.

--- a/python/sglang/srt/utils/common.py
+++ b/python/sglang/srt/utils/common.py
@@ -216,0 +217,9 @@
+def is_host_cpu_riscv64() -> bool:
+    machine = platform.machine().lower()
+    return (
+        machine in ("riscv64", "riscv64gc")
+        and hasattr(torch, "cpu")
+        and torch.cpu.is_available()
+    )
+
+
@@ -219 +228,3 @@
-    is_host_cpu_supported = is_host_cpu_x86() or is_host_cpu_arm64()
+    is_host_cpu_supported = (
+        is_host_cpu_x86() or is_host_cpu_arm64() or is_host_cpu_riscv64()
+    )
@@ -223,0 +235,15 @@
+def cpu_has_riscv_shm_support() -> bool:
+    """Return true only when the loaded AOT extension exports SHM collectives."""
+    if not is_host_cpu_riscv64():
+        return False
+    try:
+        import sgl_kernel  # noqa: F401
+    except (ImportError, OSError, RuntimeError):
+        return False
+    try:
+        return hasattr(torch.ops.sgl_kernel, "shm_allreduce")
+    except (AttributeError, RuntimeError):
+        return False
+
+
+@lru_cache(maxsize=1)
@@ -4078 +4102 @@
-        (cpu_has_amx_support() or is_host_cpu_arm64())
+        (cpu_has_amx_support() or is_host_cpu_arm64() or cpu_has_riscv_shm_support())
--- a/python/sglang/srt/arg_groups/platform_hook.py
+++ b/python/sglang/srt/arg_groups/platform_hook.py
@@ -18 +18 @@
-from sglang.srt.utils.common import is_host_cpu_arm64
+from sglang.srt.utils.common import is_host_cpu_arm64, is_host_cpu_riscv64
@@ -173 +173,3 @@
-                    "torch_native" if is_host_cpu_arm64() else "intel_amx"
+                    "torch_native"
+                    if is_host_cpu_arm64() or is_host_cpu_riscv64()
+                    else "intel_amx"
--- a/python/sglang/srt/mem_cache/allocation.py
+++ b/python/sglang/srt/mem_cache/allocation.py
@@ -47 +47,4 @@
-    from sgl_kernel import assign_req_to_token_pool_cpu
+    try:
+        from sgl_kernel import assign_req_to_token_pool_cpu
+    except ImportError:
+        assign_req_to_token_pool_cpu = None
@@ -685,0 +689,19 @@
+
+
+def _assign_req_to_token_pool_torch(
+    req_pool_indices: torch.Tensor,
+    req_to_token: torch.Tensor,
+    start_offset: torch.Tensor,
+    end_offset: torch.Tensor,
+    out_cache_loc: torch.Tensor,
+) -> None:
+    out_offset = 0
+    for i in range(req_pool_indices.numel()):
+        start = int(start_offset[i])
+        end = int(end_offset[i])
+        req_idx = int(req_pool_indices[i])
+        if end > start:
+            req_to_token[req_idx, start:end] = out_cache_loc[
+                out_offset : out_offset + end - start
+            ]
+        out_offset += end - start
@@ -697,8 +719,17 @@
-        assign_req_to_token_pool_cpu(
-            req_pool_indices,
-            req_to_token,
-            start_offset,
-            end_offset,
-            out_cache_loc,
-            req_to_token.shape[1],
-        )
+        if assign_req_to_token_pool_cpu is not None:
+            assign_req_to_token_pool_cpu(
+                req_pool_indices,
+                req_to_token,
+                start_offset,
+                end_offset,
+                out_cache_loc,
+                req_to_token.shape[1],
+            )
+        else:
+            _assign_req_to_token_pool_torch(
+                req_pool_indices,
+                req_to_token,
+                start_offset,
+                end_offset,
+                out_cache_loc,
+            )
