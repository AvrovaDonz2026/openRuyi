+++ b/python/sglang/srt/utils/common.py
@@ -214,9 +214,21 @@ def is_host_cpu_arm64() -> bool:
     )


+@lru_cache(maxsize=1)
+def is_host_cpu_riscv64() -> bool:
+    machine = platform.machine().lower()
+    return (
+        machine in ("riscv64", "riscv64gc")
+        and hasattr(torch, "cpu")
+        and torch.cpu.is_available()
+    )
+
+
 @lru_cache(maxsize=1)
 def is_cpu() -> bool:
-    is_host_cpu_supported = is_host_cpu_x86() or is_host_cpu_arm64()
+    is_host_cpu_supported = (
+        is_host_cpu_x86() or is_host_cpu_arm64() or is_host_cpu_riscv64()
+    )
     return os.getenv("SGLANG_USE_CPU_ENGINE", "0") == "1" and is_host_cpu_supported


@@ -234,6 +246,21 @@ def is_mps() -> bool:
     return torch.backends.mps.is_available()


+@lru_cache(maxsize=1)
+def cpu_has_riscv_shm_support() -> bool:
+    """Return whether the optional CPU AOT extension exports SHM collectives."""
+    if not is_host_cpu_riscv64():
+        return False
+    try:
+        import sgl_kernel  # noqa: F401
+    except (ImportError, OSError, RuntimeError):
+        return False
+    try:
+        return hasattr(torch.ops.sgl_kernel, "shm_allreduce")
+    except (AttributeError, RuntimeError):
+        return False
+
+
 def is_float4_e2m1fn_x2(dtype) -> bool:
     """Check if dtype is float4_e2m1fn_x2 and CUDA is available."""
     target_dtype = getattr(torch, "float4_e2m1fn_x2", None)
@@ -4408,7 +4435,11 @@ def get_cpu_ids_by_node():

 def is_shm_available(dtype, world_size, local_size):
     return (
-        (cpu_has_amx_support() or is_host_cpu_arm64())
+        (
+            cpu_has_amx_support()
+            or is_host_cpu_arm64()
+            or cpu_has_riscv_shm_support()
+        )
         and dtype in [torch.bfloat16, torch.float16, torch.float]
         and world_size >= 1
         and world_size == local_size
