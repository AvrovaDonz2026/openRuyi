From: A. Donz <Avrova@Donz.si>
Subject: [PATCH] cpu: add portable RISC-V shared-memory collectives

Upstream reference: https://github.com/sgl-project/sglang/tree/v0.5.21/python/sglang/kernels/aot/csrc/cpu
Upstream-Status: Downstream (no upstream RISC-V port or fix found)

--- a/python/sglang/kernels/aot/csrc/cpu/shm.cpp
+++ b/python/sglang/kernels/aot/csrc/cpu/shm.cpp
@@ -5,0 +6,2 @@
+#elif defined(__riscv)
+#include "riscv64/shm.h"
@@ -124 +126 @@
-  volatile enum coll_state* state_ptr = &(workspace[index]->states[state_group]);
+  enum coll_state* state_ptr = &(workspace[index]->states[state_group]);
@@ -127 +129 @@
-    volatile enum coll_state cur_state = *state_ptr;
+    enum coll_state cur_state = __atomic_load_n(state_ptr, __ATOMIC_ACQUIRE);
@@ -129,0 +132,4 @@
+}
+
+static inline void publish_buffer_state(enum coll_state* state_ptr, enum coll_state state) {
+  __atomic_store_n(state_ptr, state, __ATOMIC_RELEASE);
@@ -278 +284 @@
-  workspace[world_rank]->states[state_group] = copy_current;
+  publish_buffer_state(&workspace[world_rank]->states[state_group], copy_current);
@@ -327 +333 @@
-  workspace[world_rank]->states[state_group] = copy_current;
+  publish_buffer_state(&workspace[world_rank]->states[state_group], copy_current);
@@ -343 +349 @@
-  workspace[world_rank]->states[state_group] = reduce_current;
+  publish_buffer_state(&workspace[world_rank]->states[state_group], reduce_current);
@@ -414 +420 @@
-  workspace[world_rank]->states[STATE_GROUP] = copy_current;
+  publish_buffer_state(&workspace[world_rank]->states[STATE_GROUP], copy_current);
@@ -488 +494 @@
-  workspace[world_rank]->states[state_group] = copy_current;
+  publish_buffer_state(&workspace[world_rank]->states[state_group], copy_current);

--- /dev/null
+++ b/python/sglang/kernels/aot/csrc/cpu/riscv64/shm.h
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: (C) 2026 A.Donz <avrova.minix@donz.si>
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <ATen/ATen.h>
+#include <stddef.h>
+
+#define SGLANG_RISCV_REDUCE(TYPE, VALUE)       \
+  do {                                         \
+    float value = static_cast<float>(VALUE);   \
+    for (int j = 1; j < world_size; ++j)       \
+      value += static_cast<float>(*(TYPE*)(buffers[j] + i)); \
+    *(TYPE*)(to_buffer + i) = value;           \
+  } while (0)
+
+inline void reduce_bf16_buffers(
+    int start_elements, int num_elements, char* to_buffer, char** buffers, int world_size) {
+  const int element_size = 2;
+  for (int i = start_elements * element_size;
+       i < (start_elements + num_elements) * element_size;
+       i += element_size) {
+    SGLANG_RISCV_REDUCE(at::BFloat16, *(at::BFloat16*)(buffers[0] + i));
+  }
+}
+
+inline void reduce_fp16_buffers(
+    int start_elements, int num_elements, char* to_buffer, char** buffers, int world_size) {
+  const int element_size = 2;
+  for (int i = start_elements * element_size;
+       i < (start_elements + num_elements) * element_size;
+       i += element_size) {
+    SGLANG_RISCV_REDUCE(at::Half, *(at::Half*)(buffers[0] + i));
+  }
+}
+
+inline void reduce_fp32_buffers(
+    int start_elements, int num_elements, char* to_buffer, char** buffers, int world_size) {
+  const int element_size = 4;
+  for (int i = start_elements * element_size;
+       i < (start_elements + num_elements) * element_size;
+       i += element_size) {
+    SGLANG_RISCV_REDUCE(float, *(float*)(buffers[0] + i));
+  }
+}
+
+inline void parallel_memcpy(void* to, void* from, size_t n_bytes) {
+  __builtin_memcpy(to, from, n_bytes);
+}
+
+#undef SGLANG_RISCV_REDUCE
