From: A. Donz <Avrova@Donz.si>
Subject: [PATCH] cpu: select portable sources and explicit target ISA

Upstream-Reference: https://github.com/sgl-project/sglang/tree/v0.5.21/python/sglang/kernels/aot/csrc/cpu/CMakeLists.txt
Upstream-Status: Downstream (RISC-V target selection and source exclusion)

--- a/python/sglang/kernels/aot/csrc/cpu/CMakeLists.txt
+++ b/python/sglang/kernels/aot/csrc/cpu/CMakeLists.txt
@@ -1,6 +1,13 @@
 cmake_minimum_required(VERSION 3.18 FATAL_ERROR)
 project(sgl_kernel)

+# Cross builds must select the target CPU explicitly; host-specific ISA flags
+# are invalid when the compiler host and target differ.
+set(SGLANG_CPU_TARGET_ARCH "${CMAKE_SYSTEM_PROCESSOR}" CACHE STRING
+    "CPU architecture used to select platform-specific sources")
+set(SGLANG_CPU_MARCH "" CACHE STRING
+    "Optional target ISA passed as -march=<value>")
+
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
@@ -36,17 +43,17 @@ list(FILTER SOURCES EXCLUDE REGEX "^${CMAKE_CURRENT_SOURCE_DIR}/(${ARCH_DIRS})/"

 # Platform-specific source and library directory
 set(MY_ARCH_DIR "")
-if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+if(SGLANG_CPU_TARGET_ARCH MATCHES "x86_64|AMD64")
     set(PLAT_LIB_DIR "/usr/lib/x86_64-linux-gnu")
     set(MY_ARCH_DIR "x86_64")
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+elseif(SGLANG_CPU_TARGET_ARCH MATCHES "aarch64|arm64")
     set(PLAT_LIB_DIR "/usr/lib/aarch64-linux-gnu")
     set(MY_ARCH_DIR "aarch64")
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64le|ppc64")
+elseif(SGLANG_CPU_TARGET_ARCH MATCHES "ppc64le|ppc64")
     set(PLAT_LIB_DIR "/usr/lib/powerpc64le-linux-gnu")
     set(MY_ARCH_DIR "ppc64")
 else()
-    set(PLAT_LIB_DIR "/usr/lib/${CMAKE_SYSTEM_PROCESSOR}-linux-gnu")
+    set(PLAT_LIB_DIR "/usr/lib/${SGLANG_CPU_TARGET_ARCH}-linux-gnu")
 endif()
 link_directories(${PLAT_LIB_DIR})
 if(MY_ARCH_DIR)
@@ -102,8 +109,8 @@ set(SGLANG_CPU_X86_ONLY_SOURCES
     ${CMAKE_CURRENT_SOURCE_DIR}/mamba/conv.cpp
 )

-if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
-    add_compile_definitions(SGLANG_CPU_ARM64_SKIP_X86_ONLY_OPS)
+if(NOT SGLANG_CPU_TARGET_ARCH MATCHES "x86_64|AMD64")
+    add_compile_definitions(SGLANG_CPU_SKIP_X86_ONLY_OPS)
     list(REMOVE_ITEM SOURCES ${SGLANG_CPU_X86_ONLY_SOURCES})
 endif()

@@ -132,9 +139,11 @@ else()
     add_compile_options(
         -O3
         -Wno-unknown-pragmas
-        -march=native
         -fopenmp
     )
+    if(SGLANG_CPU_MARCH)
+        add_compile_options("-march=${SGLANG_CPU_MARCH}")
+    endif()
 endif()

 Python_add_library(common_ops MODULE USE_SABI ${SKBUILD_SABI_VERSION} WITH_SOABI ${SOURCES})
