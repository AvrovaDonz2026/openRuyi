From 7ff9a47724683efdd52777a9e8cbcf64bceeb0c1 Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Thu, 22 Oct 2026 01:21:17 +0800
Subject: [PATCH 1/2] Fix RVA23 host triple detection in rustup test

---
 src/cli/self_update.rs | 14 ++++++------
 src/test.rs            | 48 +-----------------------------------------
 2 files changed, 8 insertions(+), 54 deletions(-)

diff --git a/src/cli/self_update.rs b/src/cli/self_update.rs
index 88bc516..cf0fde3 100644
--- a/src/cli/self_update.rs
+++ b/src/cli/self_update.rs
@@ -1330,7 +1330,7 @@ mod tests {
     use crate::config::Cfg;
     use crate::dist::{PartialToolchainDesc, Profile};
     use crate::test::{Env, test_dir, with_rustup_home};
-    use crate::{for_host, process::TestProcess};
+    use crate::process::TestProcess;
 
     #[test]
     fn default_toolchain_is_stable() {
@@ -1351,23 +1351,23 @@ mod tests {
                 no_update_toolchain: false,
             };
 
+            let default_host_tuple = cfg.default_host_tuple().unwrap();
             assert_eq!(
                 "stable"
                     .parse::<PartialToolchainDesc>()
                     .unwrap()
-                    .resolve(&cfg.default_host_tuple().unwrap())
+                    .resolve(&default_host_tuple)
                     .unwrap(),
                 opts.select_toolchain(&mut cfg)
                     .unwrap() // result
                     .unwrap() // option
             );
             assert_eq!(
-                for_host!(
-                    r"info: profile set to default
-info: default host tuple is {0}
-"
+                format!(
+                    "info: profile set to default\n\
+                    info: default host tuple is {default_host_tuple}\n"
                 ),
-                &String::from_utf8(tp.stderr()).unwrap()
+                String::from_utf8(tp.stderr()).unwrap()
             );
             Ok(())
         })
diff --git a/src/test.rs b/src/test.rs
index 3cc7901..832d649 100644
--- a/src/test.rs
+++ b/src/test.rs
@@ -149,53 +149,7 @@ pub fn this_host_tuple() -> String {
         let tp = TestProcess::default();
         return TargetTuple::from_host(&tp.process).unwrap().to_string();
     }
-    let arch = if cfg!(target_arch = "x86") {
-        "i686"
-    } else if cfg!(target_arch = "x86_64") {
-        "x86_64"
-    } else if cfg!(target_arch = "riscv64") {
-        "riscv64gc"
-    } else if cfg!(target_arch = "aarch64") {
-        "aarch64"
-    } else if cfg!(target_arch = "loongarch64") {
-        "loongarch64"
-    } else if cfg!(target_arch = "powerpc64") && cfg!(target_endian = "little") {
-        "powerpc64le"
-    } else if cfg!(target_arch = "s390x") {
-        "s390x"
-    } else if cfg!(target_arch = "sparc64") {
-        "sparcv9"
-    } else {
-        unimplemented!()
-    };
-    let os = if cfg!(target_os = "linux") {
-        "unknown-linux"
-    } else if cfg!(target_os = "macos") {
-        "apple-darwin"
-    } else if cfg!(target_os = "illumos") {
-        "unknown-illumos"
-    } else if cfg!(target_os = "freebsd") {
-        "unknown-freebsd"
-    } else if cfg!(target_os = "solaris") {
-        if cfg!(target_arch = "sparc64") {
-            "sun-solaris"
-        } else {
-            "pc-solaris"
-        }
-    } else {
-        unimplemented!()
-    };
-    let env = if cfg!(target_env = "gnu") {
-        Some("gnu")
-    } else {
-        None
-    };
-
-    if let Some(env) = env {
-        format!("{arch}-{os}-{env}")
-    } else {
-        format!("{arch}-{os}")
-    }
+    env!("TARGET").to_owned()
 }
 
 // Format a string with this host tuple.
