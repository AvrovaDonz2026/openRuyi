%__sglang_extras_python_provides %{_rpmconfigdir}/sglangdistdeps.py --profile extras --namespace sglang-extras --provides --normalized-names-format pep503 --package-name %{name} --majorver-provides-versions %{__default_python3_version} %{?!_python_dist_allow_version_zero:--fail-if-zero}
%__sglang_extras_python_requires %{_rpmconfigdir}/sglangdistdeps.py --profile extras --namespace sglang-extras --requires --normalized-names-format pep503 --package-name %{name} %{?sglang_shared_dists:--shared-dists "%{sglang_shared_dists}"} %{?!_python_no_extras_requires:--require-extras-subpackages} --console-scripts-nodep-setuptools-since 3.10
%__sglang_extras_python_path ^/usr/lib(64)?/sglang/extras/python[3-9]\\.[[:digit:]]+/site-packages/[^/]+\\.(dist-info|egg-info|egg-link)$
