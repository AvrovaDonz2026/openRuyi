# SGLang payloads run from the private Python 3.14 ABI tree. Allow a future
# alternate runtime to override this explicitly, but do not inherit the
# guest's generic python3_version (which may be 3.13).
%_sglang_private_python %{?sglang_private_python}%{!?sglang_private_python:3.14}
%_sglang_private_interpreter %{_bindir}/python%{_sglang_private_python}
%_sglang_private_include %{_includedir}/python%{_sglang_private_python}
%_sglang_python_profile %{?sglang_python_profile}%{!?sglang_python_profile:core}
%_sglang_dep_namespace %{expr:"%{_sglang_python_profile}" == "extras" ? "sglang-extras" : "sglang"}
%_sglang_torch_profile %{expr:"%{_sglang_python_profile}" == "extras" ? "core" : "%{_sglang_python_profile}"}
# Payloads in this architecture-specific root MUST NOT use BuildArch: noarch.
%_sglang_private_root %{_libdir}/sglang/%{_sglang_python_profile}/python%{_sglang_private_python}
%_sglang_private_sitelib %{_sglang_private_root}/site-packages
%_sglang_private_sitearch %{_sglang_private_sitelib}
%_sglang_private_libexec %{_libexecdir}/sglang
%_sglang_core_sitelib %{_libdir}/sglang/core/python%{_sglang_private_python}/site-packages
%_sglang_private_pythonpath %{_sglang_private_sitelib}:%{_sglang_core_sitelib}${PYTHONPATH:+:$PYTHONPATH}
# Torch installs its config packages below ``torch/share/cmake`` in the
# private site-packages tree; include that directory explicitly because CMake
# does not recurse through a site-packages prefix when resolving CONFIG files.
%_sglang_private_cmake_prefix %{_prefix}:%{_libdir}/cmake:%{_sglang_private_sitearch}/torch/share/cmake:%{_sglang_private_sitearch}${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}

%sglang_python_compat() %{expand:
%%global sglang_python_profile %%{?1}%%{!?1:core}
%%global _sglang_private_enabled 1
%%global __python3 %%{_sglang_private_interpreter}
%%global __elf_exclude_path (^/usr/lib/debug/)|(^/lib/modules/.*\\.ko?(\\.[[:alnum:]]*)$)|((^|/)usr/lib(64)?/sglang/(core|extras)/)
%%global buildsystem_pyproject_generate_buildrequires() %%%%sglang_pyproject_buildrequires %%%%*
%%global buildsystem_pyproject_build() %%%%sglang_pyproject_wheel %%%%*
%%global buildsystem_pyproject_install() %%%%sglang_pyproject_install %%%%*
%%global buildsystem_pyproject_check() %%%%sglang_pyproject_check_import %%%%*
}

%sglang_private_rpath() %{expand:\\\
find "%{buildroot}%{_sglang_private_sitelib}" -type f -name '*.so*' -print0 | while IFS= read -r -d '' so; do
  if file "$so" | grep -q 'ELF'; then
    old=$(patchelf --print-rpath "$so")
    new=
    rpath_add() {
      case ":$new:" in
        *":$1:"*) ;;
        *) new="${new:+$new:}$1" ;;
      esac
    }
    while [ -n "$old" ]; do
      entry=${old%%%%:*}
      if [ "$entry" = "$old" ]; then
        old=
      else
        old=${old#*:}
      fi
      case "$entry" in
        \\$ORIGIN) rpath_add "$entry" ;;
        %{_libdir}/sglang/*)
          case "$entry" in
            */../*|*/./*|*/..|*/.) ;;
            *) rpath_add "$entry" ;;
          esac
          ;;
        \\$ORIGIN/*)
          case "$entry" in
            */../*|*/./*|*/..|*/.) ;;
            *) rpath_add "$entry" ;;
          esac
          ;;
      esac
    done
    rpath_add "\\$ORIGIN"
    rpath_add "%{_libdir}/sglang/%{_sglang_python_profile}/lib"
    rpath_add "%{_libdir}/sglang/%{_sglang_torch_profile}/python%{_sglang_private_python}/site-packages/torch/lib"
    patchelf --set-rpath "$new" "$so"
  fi
done
}

%sglang_pyproject_install(l:L) %{expand:\\\
export PYTHON_EXECUTABLE="%{_sglang_private_interpreter}"
export Python_EXECUTABLE="%{_sglang_private_interpreter}"
export Python3_EXECUTABLE="%{_sglang_private_interpreter}"
export PYTHON_INCLUDE_DIR="%{_sglang_private_include}"
export Python_INCLUDE_DIR="%{_sglang_private_include}"
export Python3_INCLUDE_DIR="%{_sglang_private_include}"
export CMAKE_PREFIX_PATH="%{_sglang_private_cmake_prefix}"
%%pyproject_install
mkdir -p "%{buildroot}%{_sglang_private_sitelib}" "%{buildroot}%{_sglang_private_libexec}"
for site in "%{buildroot}%{python3_sitelib}" "%{buildroot}%{python3_sitearch}"; do
  [ -d "$site" ] || continue
  find "$site" -mindepth 1 -maxdepth 1 -exec mv -t "%{buildroot}%{_sglang_private_sitelib}" -- {} +
done
if [ -d "%{buildroot}%{_bindir}" ]; then
  find "%{buildroot}%{_bindir}" -mindepth 1 -maxdepth 1 -type f -exec mv -t "%{buildroot}%{_sglang_private_libexec}" -- {} +
  rmdir "%{buildroot}%{_bindir}" 2>/dev/null || :
fi
%{__python3} %{_rpmconfigdir}/openruyi/sglang_private_paths.py \\
  --record "%{_pyproject_record}" --ghost "%{_pyproject_ghost_distinfo}" \\
  --files "%{pyproject_files}" --modules "%{_pyproject_modules}" \\
  --from-site "%{python3_sitelib}" --to-site "%{_sglang_private_sitelib}" \\
  --from-sitearch "%{python3_sitearch}" --to-sitearch "%{_sglang_private_sitearch}" \\
  --from-bin "%{_bindir}" --to-bin "%{_sglang_private_libexec}" \\
  --interpreter "%{_sglang_private_interpreter}"
%%sglang_pyproject_save_files %{-l} %{-L} %*
}

%sglang_pyproject_save_files(e:t:lLM) %{expand:\\\
%{expr:v"0%{?rpmversion}" >= v"4.18.90" ? "RPM_FILES_ESCAPE=4.19" : "RPM_FILES_ESCAPE=4.18" } \\
%{__python3} %{_rpmconfigdir}/openruyi/pyproject_save_files.py \\
  --output-files "%{pyproject_files}" --output-modules "%{_pyproject_modules}" \\
  --buildroot "%{buildroot}" --sitelib "%{_sglang_private_sitelib}" \\
  --sitearch "%{_sglang_private_sitearch}" --python-version "%{_sglang_private_python}" \\
  --pyproject-record "%{_pyproject_record}" --prefix "%{_prefix}" %{?**}
}

%sglang_pyproject_wheel(C:) %{expand:\\\
(
  export PYTHON_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python3_EXECUTABLE="%{_sglang_private_interpreter}"
  export PYTHON_INCLUDE_DIR="%{_sglang_private_include}"
  export Python_INCLUDE_DIR="%{_sglang_private_include}"
  export Python3_INCLUDE_DIR="%{_sglang_private_include}"
  export CMAKE_PREFIX_PATH="%{_sglang_private_cmake_prefix}"
  export PYTHONPATH="%{_sglang_private_pythonpath}"
  export CARGO_NET_OFFLINE=true
  export PIP_NO_INDEX=1
  %%pyproject_wheel %{**}
)
}

%sglang_pyproject_buildrequires(rRxtNwpe:g:C:) %{expand:\\\
sglang_buildrequires_output="%{_pyproject_buildrequires}.sglang"
(
  export PYTHON_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python3_EXECUTABLE="%{_sglang_private_interpreter}"
  export PYTHON_INCLUDE_DIR="%{_sglang_private_include}"
  export Python_INCLUDE_DIR="%{_sglang_private_include}"
  export Python3_INCLUDE_DIR="%{_sglang_private_include}"
  export CMAKE_PREFIX_PATH="%{_sglang_private_cmake_prefix}"
  export PYTHONPATH="%{_sglang_private_pythonpath}"
  export CARGO_NET_OFFLINE=true
  export PIP_NO_INDEX=1
  %%pyproject_buildrequires %{**}
) > "$sglang_buildrequires_output"
sglang_buildrequires_status=$?
if [ $sglang_buildrequires_status -ne 0 ]; then
  rm -f "$sglang_buildrequires_output"
  exit $sglang_buildrequires_status
fi
%{__python3} %{_rpmconfigdir}/sglangdistdeps.py --profile %{_sglang_python_profile} --namespace %{_sglang_dep_namespace} --package-name %{name} %{?sglang_private_build_deps:--private-dists "%{sglang_private_build_deps}"} %{?sglang_shared_dists:--shared-dists "%{sglang_shared_dists}"} --rewrite-requires "$sglang_buildrequires_output"
sglang_namespace_status=$?
if [ $sglang_namespace_status -ne 0 ]; then
  rm -f "$sglang_buildrequires_output"
  exit $sglang_namespace_status
fi
cat "$sglang_buildrequires_output"
rm -f "$sglang_buildrequires_output"
}

%sglang_pyproject_check_import(e:t) %{expand:\\\
(
  export PYTHON_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python_EXECUTABLE="%{_sglang_private_interpreter}"
  export Python3_EXECUTABLE="%{_sglang_private_interpreter}"
  export PYTHON_INCLUDE_DIR="%{_sglang_private_include}"
  export Python_INCLUDE_DIR="%{_sglang_private_include}"
  export Python3_INCLUDE_DIR="%{_sglang_private_include}"
  export CMAKE_PREFIX_PATH="%{_sglang_private_cmake_prefix}"
  export PYTHONPATH="%{buildroot}%{_sglang_private_sitelib}:%{_sglang_private_pythonpath}"
  %%pyproject_check_import %{?**}
)
}
